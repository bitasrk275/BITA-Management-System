# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# client files: real BITA data never goes into git (AGENTS.md rule 2)
*.zip
*.pdf
*.doc
*.docx
*.xlsx
*.xls
/client-files/

# supabase local
supabase/.temp/
supabase/.branches/

# local tool settings
/.claude/


# October desktop — local canvas state
.october/

# October (generated — context bus / browser MCP)
.codex/config.toml
.codex/hooks.json
.agents/mcp_config.json

# Build outputs and local files that must never be committed
/*.apk
apps/technician/android/
apps/technician/ios/
/*.jpg
/*.jpeg
/*.png
/*.html
