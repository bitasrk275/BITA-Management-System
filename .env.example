# Copy to .env.local and fill in values. Never commit .env.local.

# [REQUIRED] Supabase project URL (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# [REQUIRED] Supabase anonymous/public key (safe for browser; enforces Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [REQUIRED, SERVER-ONLY] Supabase service_role secret key (required for "Link a phone", /api/field/*, payment reminders, and user login provisioning; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# [REQUIRED FOR REMINDERS, SERVER-ONLY] Shared secret protecting POST/PATCH /api/reminders/plan (send via x-reminders-cron-secret header)
REMINDERS_CRON_SECRET=

# [TECHNICIAN APK BUILD] Live base URL of this web app read by apps/technician (e.g. https://bita-bms.netlify.app)
EXPO_PUBLIC_API_URL=

# [OPTIONAL, SERVER-ONLY] Anthropic Claude API key for AI enquiry extraction (lib/ai/extract-enquiry.ts)
ANTHROPIC_API_KEY=

# [OPTIONAL, SERVER-ONLY] Override the default Claude model id (defaults to claude-sonnet-5-5)
ANTHROPIC_MODEL=

# [OPTIONAL] Override BITA address line shown on printed quotations
NEXT_PUBLIC_BITA_ADDRESS=

# [OPTIONAL] Override BITA contact/subtitle line shown on printed quotations
NEXT_PUBLIC_BITA_CONTACT=

# [OPTIONAL] BITA GSTIN shown on printed quotations when set
NEXT_PUBLIC_BITA_GSTIN=

# [OPTIONAL / LEGACY MIRROR, SERVER-ONLY] Zoho Books India OAuth client ID
ZOHO_CLIENT_ID=

# [OPTIONAL / LEGACY MIRROR, SERVER-ONLY] Zoho Books India OAuth client secret
ZOHO_CLIENT_SECRET=

# [OPTIONAL / LEGACY MIRROR, SERVER-ONLY] Zoho Books India OAuth refresh token
ZOHO_REFRESH_TOKEN=

# [OPTIONAL / LEGACY MIRROR, SERVER-ONLY] Zoho Books India organization ID
ZOHO_ORGANIZATION_ID=
